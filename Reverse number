pragma solidity ^0.8.20;

contract ReverseNumber {
    function reverse(uint number) public pure returns (uint) {
        uint reversed = 0;

        while (number > 0) {
            uint digit = number % 10;
            reversed = reversed * 10 + digit;
            number = number / 10;
        }

        return reversed;
    }
}
